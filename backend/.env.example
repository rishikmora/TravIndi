# Runtime app connection — the non-superuser role, so RLS applies. Password
# must match infra/.env's APP_DB_PASSWORD.
# For a real deployment, point this at Supabase instead (Session Pooler
# connection string from the Supabase dashboard, travindi_app role) — see
# ../DEPLOYMENT.md. The local-Postgres value below is only for a from-scratch
# `docker compose up` local dev setup.
DATABASE_URL=postgresql+asyncpg://travindi_app:change-me-locally-too@localhost:5432/travindi
# DDL owner — used only by Alembic (alembic/env.py), never by the app itself.
# Password must match infra/.env's POSTGRES_PASSWORD.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://travindi:change-me-locally@localhost:5432/travindi
# Declared but not currently read by any code path (grep app/ for
# `redis_url`/`import redis` to confirm) — required here only because
# Settings has no default for it. Any reachable value works; a free
# Upstash Redis instance is the easiest if you want one ready for later.
REDIS_URL=redis://localhost:6379/0
# Same story as Redis above — declared for a future upload feature
# (see app/domains/trust/models.py's Verification.documents docstring),
# never actually called yet. Any value satisfies Settings.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=travindi
S3_SECRET_KEY=change-me-locally
S3_BUCKET=travindi-media

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated is fine too, e.g.:
# CORS_ALLOWED_ORIGINS=https://travindi.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Phase 9: auth/authz. Requires `docker compose --profile full up -d`
# locally, or docker-compose.prod.yml in production (see ../DEPLOYMENT.md).
# In production these point at the compose-internal service names
# (http://keycloak:8080 / http://opa:8181), never a public URL — the
# backend is the only caller of either, browsers never talk to them. ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=travindi
KEYCLOAK_AUDIENCE=travindi-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=backend-service-secret-change-me-locally
OPA_URL=http://localhost:8181

# --- Phase 12: AI/RAG trip planner. ---
# Anthropic Claude — the planner agent's LLM. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Embeddings run locally via sentence-transformers — no API key, no cost.
# Weights download once (cached under ~/.cache) on first use.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
