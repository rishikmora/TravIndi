# Public, non-secret settings for production builds of the hosted demo (e.g. Vercel).
# The site serves its built-in sample data; there is no backend to connect to yet.
# To use a real API later, set NEXT_PUBLIC_DATA_MODE=api and NEXT_PUBLIC_API_BASE_URL
# in the hosting provider's environment variables — those override this file.
# Never put secrets here: every NEXT_PUBLIC_* value ends up in the browser.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_DEMO_MODE=true
