# Copy to .env before running `docker compose up`.

POSTGRES_DB=travindi
POSTGRES_USER=travindi
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# Dedicated non-superuser app role — the backend connects as this, never as
# POSTGRES_USER, so Row-Level Security actually applies (superusers bypass
# RLS unconditionally). See infra/postgres/02-app-role.sh.
APP_DB_PASSWORD=change-me-locally-too

REDIS_PORT=6379

MINIO_ROOT_USER=travindi
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --full profile only (Phase 9+) --
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_PORT=8080
OPA_PORT=8181
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# -- docker-compose.prod.yml only (see ../DEPLOYMENT.md) --
# A real domain with an A/AAAA record pointing at this VPS's IP — Caddy
# requests a Let's Encrypt certificate for it automatically on first boot.
API_DOMAIN=api.example.com
