# ─────────────────────────────────────────────────────────────────────────────
# TravIndi frontend configuration. Every value here is public (NEXT_PUBLIC_*)
# and ends up in the browser bundle — never put secrets, database credentials
# or AI provider keys in this file. The backend holds those.
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin: canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ── Data source ──────────────────────────────────────────────────────────────
# mock → in-browser development backend with sample data (default in `next dev`)
# api  → the FastAPI backend below (default in production builds that set NEXT_PUBLIC_API_BASE_URL)
# Production builds without NEXT_PUBLIC_API_BASE_URL always serve the labelled sample data.
NEXT_PUBLIC_DATA_MODE=mock
# With an API configured, production ignores DATA_MODE=mock unless this is explicitly true (demos only).
NEXT_PUBLIC_DEMO_MODE=false

# FastAPI origin, without a trailing slash. Paths are /v1/... (see FRONTEND_BACKEND_CONTRACT.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional separate auth origin; defaults to the API origin.
NEXT_PUBLIC_AUTH_BASE_URL=
# Realtime gateway origin (ws:// or wss://). Defaults to the API origin with a ws scheme.
NEXT_PUBLIC_WS_URL=
# cookie → httpOnly session cookie (recommended) · bearer → short-lived token held in memory
NEXT_PUBLIC_AUTH_MODE=cookie
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# ── Maps and assets ──────────────────────────────────────────────────────────
# MapLibre style JSON URL. Without it the map uses the built-in schematic view.
NEXT_PUBLIC_MAP_STYLE_URL=
# CDN origin for 3D models, video and imagery. Images from other origins are not rendered.
NEXT_PUBLIC_ASSET_CDN=
NEXT_PUBLIC_DRACO_DECODER_PATH=https://www.gstatic.com/draco/versioned/decoders/1.5.7/
NEXT_PUBLIC_BASIS_TRANSCODER_PATH=/vendor/basis/

# Offline support (service worker). Defaults on in production builds.
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=

# ── Feature flags ────────────────────────────────────────────────────────────
# Capabilities come from GET /v1/capabilities. Set a flag to `false` to force a
# feature off regardless of the backend; leave empty to follow the backend.
NEXT_PUBLIC_ENABLE_LIVE_CROWD=
NEXT_PUBLIC_ENABLE_WEATHER=
NEXT_PUBLIC_ENABLE_TRANSPORT=
NEXT_PUBLIC_ENABLE_PUSH=
NEXT_PUBLIC_ENABLE_PAYMENT=
NEXT_PUBLIC_ENABLE_AUTO_ADAPTATION=
NEXT_PUBLIC_ENABLE_TURN_BY_TURN=
NEXT_PUBLIC_ENABLE_SMS=
NEXT_PUBLIC_ENABLE_OFFLINE_MESSAGE_QUEUE=
NEXT_PUBLIC_ENABLE_AUTHORITY_INTEGRATION=
NEXT_PUBLIC_ENABLE_COMMUNITY=
NEXT_PUBLIC_ENABLE_GAMIFICATION=
NEXT_PUBLIC_ENABLE_BOOKINGS=
NEXT_PUBLIC_ENABLE_LOCATION_SHARING=
